# ==============================================================================
# WEEEK → Linear Migration Tool Environment Configuration
# ==============================================================================
# ВНИМАНИЕ: Никогда не сохраняйте реальные токены в публичный репозиторий!
# Скопируйте этот файл в .env и укажите ваши ключи API.
# ==============================================================================

# API токен WEEEK (Настройки профиля / API в WEEEK)
# Пример: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... или обычный токен
WEEEK_API_TOKEN=your_weeek_api_token_here

# API токен Linear (Personal API Key: https://linear.app/settings/account/security)
# Пример: lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINEAR_API_TOKEN=your_linear_api_token_here

# Уровень логирования: trace | debug | info | warn | error | silent (по умолчанию: info)
LOG_LEVEL=info

# Максимальное количество параллельных запросов к API (по умолчанию: 3)
API_CONCURRENCY=3

# Путь к файлу сохранения состояния миграции для возобновления (--resume)
STATE_FILE=.weeek-linear/state.json
